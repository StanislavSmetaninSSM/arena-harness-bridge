{
  "manifest_version": 3,
  "name": "Arena Harness Bridge",
  "description": "Connect one Arena Agent Mode conversation to your local project terminal.",
  "version": "0.1.48",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "https://arena.ai/*", "https://www.arena.ai/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "Arena Harness Bridge"},
  "content_scripts": [{
    "matches": ["https://arena.ai/*", "https://www.arena.ai/*"],
    "js": ["core.js", "generated-images.js", "native-questions.js", "adapter.js", "content.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://arena.ai/*", "https://www.arena.ai/*"],
    "js": ["raw-reply.js"],
    "world": "MAIN",
    "run_at": "document_start"
  }]
}
